# Optional. Leave blank to run in demo mode (data saved in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Market-data endpoints (defaults shown). If binance.com is blocked
# in your region, use https://data-api.binance.vision and wss://data-stream.binance.vision
NEXT_PUBLIC_BINANCE_REST=https://api.binance.com
NEXT_PUBLIC_BINANCE_WS=wss://stream.binance.com:9443
